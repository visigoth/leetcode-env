# Justfile for C++ leetcode solutions
set fallback

clean:
    rm -rf build

build flavor="debug":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{flavor}}" in
        debug)   build_type="Debug" ;;
        profile) build_type="RelWithDebInfo" ;;
        *)       echo "Unknown flavor: {{flavor}}"; exit 1 ;;
    esac
    cmake -B build -S . -DCMAKE_BUILD_TYPE="$build_type" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
    cmake --build build --parallel
    ~/.pyenv/versions/leetcode/bin/lc cpp fix-clangd
    echo 'CompileFlags:' > .clangd
    echo '  CompilationDatabase: build' >> .clangd

profile problem_number mode="functions" reps="":
    #!/usr/bin/env bash
    set -euo pipefail

    TEST_FILE="{{problem_number}}.cpp"
    BENCH_FILE="bench/{{problem_number}}.cpp"

    # Generate/regenerate benchmark skeleton if needed
    if [[ ! -f "$BENCH_FILE" ]] || [[ "$TEST_FILE" -nt "$BENCH_FILE" ]]; then
        echo "Generating benchmark skeleton..."
        ~/.pyenv/versions/leetcode/bin/lc cpp gen-bench {{problem_number}}
    fi

    # Build the benchmark
    cmake -B build -S . -DCMAKE_BUILD_TYPE=RelWithDebInfo
    cmake --build build --parallel --target bench_{{problem_number}} --parallel

    # Build benchmark args
    BENCH_ARGS=""
    if [[ -n "{{reps}}" ]]; then
        BENCH_ARGS="--benchmark_repetitions={{reps}}"
    fi

    case "{{mode}}" in
        functions)
            # Flame graph profiling with samply
            MallocNanoZone=0 samply record ./build/bench_{{problem_number}} $BENCH_ARGS 2>/dev/null
            ;;
        lines)
            # Line-level profiling with Instruments
            trace_file="profile_p{{problem_number}}_$(date +%Y%m%d_%H%M%S).trace"
            MallocNanoZone=0 xcrun xctrace record \
                --template 'Time Profiler' \
                --no-prompt \
                --output "$trace_file" \
                --launch -- ./build/bench_{{problem_number}} $BENCH_ARGS \
                || true
            open "$trace_file"
            ;;
        memory)
            # Heap allocation profiling with Instruments
            trace_file="memory_p{{problem_number}}_$(date +%Y%m%d_%H%M%S).trace"
            MallocNanoZone=0 xcrun xctrace record \
                --template 'Allocations' \
                --no-prompt \
                --output "$trace_file" \
                --launch -- ./build/bench_{{problem_number}} $BENCH_ARGS \
                || true
            open "$trace_file"
            ;;
        *)
            echo "Unknown mode: {{mode}}. Use 'functions', 'lines', or 'memory'"
            exit 1
            ;;
    esac

debug filter="": build
    #!/usr/bin/env bash
    set -euo pipefail

    rr="command alias rr process launch"

    if [[ -z "{{filter}}" ]]; then
        lldb ./build/leetcode_tests \
            -o "$rr"
    elif [[ "{{filter}}" =~ ^[0-9]+$ ]]; then
        lldb ./build/leetcode_tests \
            -o "$rr" \
            -o "breakpoint set -r 'leetcode::p{{filter}}::P{{filter}}_.*::TestBody'" \
            -o "settings set target.run-args -- --gtest_filter=*P{{filter}}*"
    else
        lldb ./build/leetcode_tests \
            -o "$rr" \
            -o "settings set target.run-args -- --gtest_filter={{filter}}"
    fi

test filter="*": build
    #!/usr/bin/env bash
    set -euo pipefail

    # If filter is just a number, wrap it as *P<number>*
    if [[ "{{filter}}" =~ ^[0-9]+$ ]]; then
        ./build/leetcode_tests --gtest_filter="*P{{filter}}*"
    else
        ./build/leetcode_tests --gtest_filter="{{filter}}"
    fi

# Justfile for C++ leetcode solutions
set fallback

clean:
    rm -rf build

build:
    cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
    cmake --build build
    python3 fix_compile_commands.py
    echo 'CompileFlags:' > .clangd
    echo '  CompilationDatabase: build' >> .clangd

debug filter="": build
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -z "{{filter}}" ]]; then
        lldb ./build/leetcode_tests
    elif [[ "{{filter}}" =~ ^[0-9]+$ ]]; then
        lldb ./build/leetcode_tests \
            -o "breakpoint set -r 'leetcode::p{{filter}}::P{{filter}}_.*::TestBody'" \
            -o "settings set target.run-args -- --gtest_filter=*P{{filter}}*"
    else
        lldb ./build/leetcode_tests \
            -o "settings set target.run-args -- --gtest_filter={{filter}}"
    fi

test filter="*": build
    #!/usr/bin/env bash
    set -euo pipefail

    # If filter is just a number, wrap it as *P<number>*
    if [[ "{{filter}}" =~ ^[0-9]+$ ]]; then
        ./build/leetcode_tests --gtest_filter="*P{{filter}}*"
    else
        ./build/leetcode_tests --gtest_filter="{{filter}}"
    fi

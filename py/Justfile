# Justfile for Python leetcode solutions
set fallback

build:
    pip install -e .[dev]

test filter="":
    #!/usr/bin/env bash
    set -euo pipefail

    if [ -z "{{filter}}" ]; then
        pytest
    elif [[ "{{filter}}" =~ ^[0-9]+$ ]]; then
        # If filter is just a number, match the problem file
        pytest -k "p{{filter}}"
    else
        pytest -k "{{filter}}"
    fi

profile problem_number times="10":
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p profile-output
    sudo py-spy record --output profile-output/p{{problem_number}}.svg --format flamegraph \
        -- python -m pytest -k "p{{problem_number}}" --count={{times}} -q
    open profile-output/p{{problem_number}}.svg
